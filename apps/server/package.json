{
  "name": "@llm-wiki/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LLM Wiki server — Fastify API + workers that reuse the src/lib core. Standalone sub-package (like mcp-server/); not part of the root workspace.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pgvector": "^0.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
