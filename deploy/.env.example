# Copy to deploy/.env and edit. Same file for home server and cloud.

# --- Postgres ---
POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmwiki

# --- Server ---
# Host port to expose the API on.
SERVER_PORT=8080
# Bootstrap admin API token (first-boot / machine clients). Generate a strong
# random value. Used as Authorization: Bearer <token> or X-LLM-Wiki-Token.
LLM_WIKI_AUTH_TOKEN=change-me-too
# Allow unauthenticated READ access (single-user LAN convenience). Keep false
# for anything reachable from the internet.
ALLOW_UNAUTHENTICATED=false
# CORS allowlist; "*" for LAN/dev, or comma-separated origins for production.
CORS_ORIGINS=*
# Embedding dimensionality (informational until an HNSW index is pinned).
EMBEDDING_DIM=1536

# --- Provider API keys (server-side only; never sent to clients) ---
# Set whichever providers you use; consumed by the chat/embedding pipeline.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- TLS (only when running `--profile tls`) ---
# Public domain Caddy obtains a certificate for (home server via DuckDNS, etc.).
TLS_DOMAIN=
